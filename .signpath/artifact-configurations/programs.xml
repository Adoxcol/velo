<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "programs" (stage 1 of .github/workflows/release.yml).
     The GitHub artifact is a zip holding the three programs at its root. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="velo.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="velo-host.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="veloctl.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
