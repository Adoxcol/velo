<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer" (stage 2 of .github/workflows/release.yml).
     The GitHub artifact is a zip holding Velo-Setup-<version>.exe at its root. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="Velo-Setup-*.exe" min-matches="1" max-matches="1" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
