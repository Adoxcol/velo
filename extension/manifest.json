{
  "manifest_version": 3,
  "name": "Velo",
  "version": "0.6.0",
  "description": "One-click downloads with Velo: grab files and videos, and download all links on a page.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "webRequest",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Velo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n.js",
        "overlay.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
